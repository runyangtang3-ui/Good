-- ============ 忽略集合 ============
local ignoreSet = {}
local function MarkIgnore(inst)
    if inst then
        ignoreSet[inst] = true
        for _, d in ipairs(inst:GetDescendants()) do ignoreSet[d] = true end
    end
end
MarkIgnore(ringModel)
MarkIgnore(crossModel)
MarkIgnore(marker)
if highlight then MarkIgnore(highlight) end

local function RefreshIgnorePlayers()
    for _, p in ipairs(Players:GetPlayers()) do
        local c = p.Character
        if c then MarkIgnore(c) end
    end
end
RefreshIgnorePlayers()
Players.PlayerAdded:Connect(function() RefreshIgnorePlayers() end)
Players.PlayerRemoving:Connect(function() RefreshIgnorePlayers() end)

-- ============ 扫描 ============
local function GetNearbyObjects(rootPos)
    local seen = {}
    local candidates = {}
    local function check(obj)
        if seen[obj] or ignoreSet[obj] then return end
        seen[obj] = true
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local pos = GetObjPosition(obj)
            if pos and pos.Magnitude > 0.001 then
                local dist = (pos - rootPos).Magnitude
                if dist <= Settings.radius then
                    table.insert(candidates, {obj = obj, pos = pos})
                end
            end
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do check(obj) end
    for _, obj in getnilinstances() do check(obj) end
    return candidates
end

local lockedTarget = nil

-- ============ 显隐控制 ============
local function SetVisual(visible)
    local t = visible and 0 or 1
    for i = 1, SEGMENTS do ring[i].Transparency = t end
    crossH.Transparency = visible and 0.25 or 1
    crossV.Transparency = visible and 0.25 or 1
    coreGlow.Transparency = visible and 0.3 or 1
    if marker then marker.Transparency = 1 end
end

-- ============ 渲染循环 ============
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local pos = root.Position
    local y = pos.Y - 2.5
    local R = Settings.radius
    local spin = os.clock() * 0.6

    for i = 1, SEGMENTS do
        local angle = (i - 1) / SEGMENTS * math.pi * 2 + spin
        ring[i].CFrame = CFrame.new(
            pos.X + math.cos(angle) * R,
            y,
            pos.Z + math.sin(angle) * R
        )
    end

    local look = root.CFrame.LookVector
    local yaw = math.atan2(-look.Z, look.X)
    crossH.Size = Vector3.new(R * 2, 0.5, 0.5)
    crossV.Size = Vector3.new(0.5, 0.5, R * 2)
    crossH.CFrame = CFrame.new(pos.X, y, pos.Z) * CFrame.Angles(0, yaw, 0)
    crossV.CFrame = CFrame.new(pos.X, y, pos.Z) * CFrame.Angles(0, yaw, 0)
    coreGlow.CFrame = CFrame.new(pos.X, y, pos.Z)

    if markerOK then
        if lockedTarget and Settings.showLock then
            marker.Transparency = 0
            local mp = lockedTarget.pos
            marker.CFrame = CFrame.new(mp.X, mp.Y + 6, mp.Z)
        else
            marker.Transparency = 1
        end
    end

    if highlightOK then
        if lockedTarget and Settings.showLock then
            pcall(function() highlight.Adornee = lockedTarget.obj end)
        else
            pcall(function() highlight.Adornee = nil end)
        end
    end
end)

-- ============ 主逻辑 ============
task.spawn(function()
    local cooldown = {}
    local candidates = {}
    local lastScan = 0
    local lastWarn = 0
    local equipped = false

    print("[ChopAura] v18 启动，默认开启，拿斧砍树")

    while true do
        task.wait(0.1)

        local chopEvent, tool = FindChopEvent()
        if not chopEvent then
            local now = os.clock()
            if now - lastWarn > 2 then
                lastWarn = now
                warn("[ChopAura] 未找到带 ChopEvent 的斧头")
            end
            continue
        end

        local inHand = tool.Parent == LocalPlayer.Character
        if inHand ~= equipped then
            equipped = inHand
            if equipped then
                print("[ChopAura] 斧头已拿起")
            else
                lockedTarget = nil
                print("[ChopAura] 斧头已放下")
            end
        end

        if not Settings.enabled or not equipped then
            SetVisual(false)
            lockedTarget = nil
            continue
        end

        SetVisual(true)

        local char = LocalPlayer.Character
        if not char then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then continue end

        local now = os.clock()
        local rootPos = root.Position

        if now - lastScan > 0.5 then
            lastScan = now
            candidates = GetNearbyObjects(rootPos)
        end

        local nearest = nil
        local bestDist = math.huge
        for _, c in ipairs(candidates) do
            local dist = (c.pos - rootPos).Magnitude
            if dist < bestDist then
                bestDist = dist
                nearest = c
            end
        end
        lockedTarget = (nearest and bestDist <= Settings.radius) and nearest or nil

        local hitCount = 0
        for _, c in ipairs(candidates) do
            local dist = (c.pos - rootPos).Magnitude
            if dist > Settings.chopRange then continue end

            local last = cooldown[c.obj] or 0
            if now - last < Settings.cooldown then continue end
            cooldown[c.obj] = now

            local origin = rootPos + Vector3.new(0, Settings.rayHeight, 0)
            chopEvent:FireServer(c.obj, CFrame.lookAt(origin, c.pos), false)
            hitCount = hitCount + 1
        end

        if hitCount > 0 then
            print("[ChopAura] 触发 " .. hitCount .. " 次")
        end
    end
end)
