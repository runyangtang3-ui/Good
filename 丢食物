	local function safeExecute(fn, ...)
		local args = table.pack(...)
		return function()
			local ok, err = xpcall(function()
				fn(table.unpack(args, 1, args.n))
			end, handleError)
			return ok, err
		end
	end
	pcall(function()
		function task.spawn(fn, ...)
			return originalSpawn(safeExecute(fn, ...))
		end
	end)
	pcall(function()
