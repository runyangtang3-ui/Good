			and inst.Size.Y.Offset >= 34
			and inst.Size.Y.Offset <= 44
		then
			if not inst:GetAttribute("SkinHub_Tab") then
				inst:SetAttribute("SkinHub_Tab", true)
				setStroke(inst, BORDER_GLOW, 1, 0.55)
				setGradient(inst, MAIN, Color3.fromRGB(math.min(255, MAIN.R * 255 + 8), math.min(255, MAIN.G * 255 + 8), math.min(255, MAIN.B * 255 + 14)), 90)
			end
			return
		end
		if (inst:IsA("TextButton") or inst:IsA("TextBox"))
			and inst.Size.Y.Offset >= 18
			and inst.Size.Y.Offset <= 25
			and inst.BackgroundTransparency < 1
			and inst.BackgroundColor3 ~= Color3.new(1, 1, 1)
		then
			if not inst:GetAttribute("SkinHub_Ctrl") then
				inst:SetAttribute("SkinHub_Ctrl", true)
				setCorner(inst, 6)
				setStroke(inst, OUTLINE, 1, 0.1)
				if inst.BackgroundColor3 == MAIN or inst.BackgroundColor3 == BG then
					setGradient(inst, inst.BackgroundColor3, Color3.fromRGB(math.min(255, inst.BackgroundColor3.R * 255 + 10), math.min(255, inst.BackgroundColor3.G * 255 + 10), math.min(255, inst.BackgroundColor3.B * 255 + 16)), 90)
				end
				local baseColor = inst.BackgroundColor3
				inst.MouseEnter:Connect(function()
					if inst:GetAttribute("SkinHub_Dis") then
						return
					end
					TweenService:Create(inst, TweenInfo.new(0.15), { BackgroundColor3 = HOVER_BG }):Play()
				end)
				inst.MouseLeave:Connect(function()
					if inst:GetAttribute("SkinHub_Dis") then
						return
					end
					TweenService:Create(inst, TweenInfo.new(0.15), { BackgroundColor3 = baseColor }):Play()
				end)
			end
			return
		end
		if inst:IsA("Frame") and inst.BackgroundTransparency == 0 then
			local corner = inst:FindFirstChildOfClass("UICorner")
			if corner and inst:FindFirstChildOfClass("UIStroke") and not inst:GetAttribute("SkinHub_Box") then
				inst:SetAttribute("SkinHub_Box", true)
				local s = inst:FindFirstChildOfClass("UIStroke")
				if s then
					s.Color = BORDER_GLOW
					s.Transparency = 0.55
					s.Thickness = 1
				end
			end
		end
	end
	task.defer(function()
		local sg = Library.ScreenGui
		if not sg then
			return
		end
		for _, inst in sg:GetDescendants() do
			pcall(beautify, inst)
		end
		table.insert(L._themeWatchConns, sg.DescendantAdded:Connect(function(inst)
			task.defer(function()
				pcall(beautify, inst)
			end)
		end))
	end)
end
for _, opt in pairs(Options) do
	if type(opt) == "table" and opt.Type == "KeyPicker" and not opt.SkinHubBlankNone then
		opt.SkinHubBlankNone = true
		local update = opt.Update
		function opt.Update(self, ...)
			if self.Value == "None" then
				self.DisplayValue = ""
			end
			return update(self, ...)
		end
		opt:Update()
	end
end


--==========================================================
-- 完美投掷（已汉化整合）
-- 接管游戏投掷计量器 ThrowMeter：把自动点击阈值锁定 0.6，
-- 并强制锁定投掷条，稳定命中完美区间
--==========================================================
do
	local ThrowFeature = {
		Enabled = false,
		Status = "未启用",
		Meter = nil,
		OriginalRun = nil,
		Wrapper = nil
	}
	getgenv().HXPerfectThrow = ThrowFeature

	local function getThrowMeter()
		if ThrowFeature.Meter then
			return ThrowFeature.Meter
		end
		local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
		if not playerScripts then
			return nil
		end
		local client = playerScripts:FindFirstChild("Client")
		if not client then
			return nil
		end
		local controllers = client:FindFirstChild("Controllers")
		if not controllers then
			return nil
		end
		local moduleScript = controllers:FindFirstChild("ThrowMeter")
		if not moduleScript then
			return nil
		end
		local ok, meter = pcall(require, moduleScript)
		if not ok or type(meter) ~= "table" or type(meter.Run) ~= "function" then
			return nil
		end
		ThrowFeature.Meter = meter
		return meter
	end

	local function stopPerfectThrow()
		if not ThrowFeature.Enabled then
			ThrowFeature.Status = "未启用"
			return
		end
		ThrowFeature.Enabled = false
		ThrowFeature.Status = "已关闭"
		local meter = ThrowFeature.Meter
		if meter and ThrowFeature.Wrapper and meter.Run == ThrowFeature.Wrapper then
			meter.Run = ThrowFeature.OriginalRun
		end
	end

	local function startPerfectThrow()
		if ThrowFeature.Enabled then
			ThrowFeature.Status = "运行中"
			return true
		end
		local meter = getThrowMeter()
		if not meter then
			ThrowFeature.Status = "未找到投掷控制器"
			return false
		end
		local originalRun = meter.Run
		ThrowFeature.OriginalRun = originalRun
		local wrapper
		wrapper = function(instance, ...)
			if not ThrowFeature.Enabled then
				return originalRun(instance, ...)
			end
			local previousTap = meter.TestAutoTap
			meter.TestAutoTap = 0.6
			pcall(function()
				instance:SetLocked(true)
			end)
			local results = table.pack(pcall(originalRun, instance, ...))
			if meter.TestAutoTap == 0.6 then
				meter.TestAutoTap = previousTap
			end
			if not results[1] then
				error(results[2], 0)
			end
			return table.unpack(results, 2, results.n)
		end
		ThrowFeature.Wrapper = wrapper
		meter.Run = wrapper
		ThrowFeature.Enabled = true
		ThrowFeature.Status = "运行中"
		return true
	end

	Tabs.Throw = Window:AddTab("完美投掷", "crosshair")
	local ThrowGroup = Tabs.Throw:AddGroupbox({ Side = "Left", Name = "完美投掷" })
	local ThrowStatus = ThrowGroup:AddLabel("状态：未启用")

	local function refreshThrowStatus()
		pcall(function()
			ThrowStatus:Set("状态：" .. ThrowFeature.Status)
		end)
	end

	local ThrowToggle
	ThrowToggle = ThrowGroup:AddToggle("PerfectThrowToggle", {
		Text = "启用完美投掷",
		Default = false,
		["Callback"] = function(value)
			if value then
				if not startPerfectThrow() then
					pcall(function()
						ThrowToggle:SetValue(false)
					end)
					pcall(function()
						Library:Notify("未找到投掷控制器，请在投掷玩法中使用", 4)
					end)
				end
			else
				stopPerfectThrow()
			end
			refreshThrowStatus()
		end
	})

	ThrowGroup:AddButton("重新接管投掷控制器", function()
		if ThrowFeature.Enabled then
			stopPerfectThrow()
		end
		ThrowFeature.Meter = nil
		local ok = startPerfectThrow()
		if ok and ThrowToggle then
			pcall(function()
				ThrowToggle:SetValue(true)
			end)
		end
		refreshThrowStatus()
	end)

	ThrowGroup:AddLabel("说明：自动锁定完美投掷力度，命中即为完美投掷")

	local previousCleanup = getgenv().SkinHubCleanupAll
	getgenv().SkinHubCleanupAll = function()
		pcall(stopPerfectThrow)
		if previousCleanup then
			pcall(previousCleanup)
		end
	end

	task.spawn(function()
		while true do
			task.wait(1)
			refreshThrowStatus()
		end
	end)
end
