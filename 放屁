-- ==================== 注入动画 ====================
local function playIntroAnimation()
    local player = game:GetService("Players").LocalPlayer
    local tweenService = game:GetService("TweenService")
    local runService = game:GetService("RunService")

    local gui = Instance.new("ScreenGui")
    gui.Name = "RedStarIntro"
    gui.IgnoreGuiInset = true
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 999999
    gui.Parent = player:WaitForChild("PlayerGui")

    -- 黑色背景
    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    bg.BackgroundTransparency = 1
    bg.BorderSizePixel = 0
    bg.ZIndex = 1
    bg.Parent = gui

    -- 用于屏幕抖动的容器（把所有内容都放进去）
    local shakeHolder = Instance.new("Frame")
    shakeHolder.Size = UDim2.new(1, 0, 1, 0)
    shakeHolder.BackgroundTransparency = 1
    shakeHolder.ZIndex = 2
    shakeHolder.Parent = gui

    -- ==================== 中间大星星 ====================
    local bigStarHolder = Instance.new("Frame")
    bigStarHolder.Size = UDim2.new(0, 600, 0, 600)
    bigStarHolder.Position = UDim2.new(0.5, -300, 0.5, -300)
    bigStarHolder.BackgroundTransparency = 1
    bigStarHolder.ZIndex = 3
    bigStarHolder.Parent = shakeHolder

    local function makeTextStar(parent, color, offset, inset, zindex)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, inset, 1, inset)
        lbl.Position = UDim2.new(0, offset, 0, offset)
        lbl.BackgroundTransparency = 1
        lbl.Text = "★"
        lbl.TextColor3 = color
        lbl.TextScaled = true
        lbl.TextTransparency = 1
        lbl.Font = Enum.Font.GothamBold
        lbl.ZIndex = zindex
        lbl.Parent = parent
        return lbl
    end

    local bigStarDeep = makeTextStar(bigStarHolder, Color3.fromRGB(90, 0, 0), 20, 20, 2)
    local bigStarMid = makeTextStar(bigStarHolder, Color3.fromRGB(150, 0, 0), 10, 10, 3)
    local bigStar = makeTextStar(bigStarHolder, Color3.fromRGB(255, 20, 20), 0, 0, 4)
    local bigStarShine = makeTextStar(bigStarHolder, Color3.fromRGB(255, 130, 130), -20, -40, 5)
    local bigStarCore = makeTextStar(bigStarHolder, Color3.fromRGB(255, 230, 230), -40, -80, 6)

    -- 大星星光晕
    local bigGlow = Instance.new("ImageLabel")
    bigGlow.Size = UDim2.new(0, 900, 0, 900)
    bigGlow.Position = UDim2.new(0.5, -450, 0.5, -450)
    bigGlow.BackgroundTransparency = 1
    bigGlow.Image = "rbxassetid://5028857084"
    bigGlow.ImageColor3 = Color3.fromRGB(255, 20, 20)
    bigGlow.ImageTransparency = 1
    bigGlow.ZIndex = 2
    bigGlow.Parent = shakeHolder

    -- ==================== 中心小星星 ====================
    local starHolder = Instance.new("Frame")
    starHolder.Size = UDim2.new(0, 200, 0, 200)
    starHolder.Position = UDim2.new(0.5, -100, 0.5, -100)
    starHolder.BackgroundTransparency = 1
    starHolder.ZIndex = 7
    starHolder.Parent = shakeHolder

    local starShadow = makeTextStar(starHolder, Color3.fromRGB(80, 0, 0), 8, 8, 6)
    local star = makeTextStar(starHolder, Color3.fromRGB(255, 20, 20), 0, 0, 7)
    local starShine = makeTextStar(starHolder, Color3.fromRGB(255, 180, 180), -5, -10, 8)

    -- 流星容器
    local meteorHolder = Instance.new("Frame")
    meteorHolder.Size = UDim2.new(1, 0, 1, 0)
    meteorHolder.BackgroundTransparency = 1
    meteorHolder.ZIndex = 9
    meteorHolder.Parent = shakeHolder

    -- 屏幕抖动控制
    local shakeIntensity = 0
    local shakeConn = runService.RenderStepped:Connect(function()
        if shakeIntensity > 0.01 then
            local ox = (math.random() - 0.5) * 2 * shakeIntensity
            local oy = (math.random() - 0.5) * 2 * shakeIntensity
            shakeHolder.Position = UDim2.new(0, ox, 0, oy)
            shakeIntensity = shakeIntensity * 0.85  -- 逐渐衰减
        elseif shakeHolder.Position ~= UDim2.new(0, 0, 0, 0) then
            shakeHolder.Position = UDim2.new(0, 0, 0, 0)
        end
    end)

    -- 流星函数
    local function createMeteor()
        -- 流星出现瞬间，触发屏幕抖动
        shakeIntensity = math.max(shakeIntensity, 8)

        local meteor = Instance.new("Frame")
        meteor.Size = UDim2.new(0, 180, 0, 3)
        meteor.BackgroundColor3 = Color3.fromRGB(255, 30, 30)
        meteor.BorderSizePixel = 0
        meteor.AnchorPoint = Vector2.new(0.5, 0.5)
        local startX = math.random(-20, 70) / 100
        local startY = math.random(-10, 30) / 100
        meteor.Position = UDim2.new(startX, 0, startY, 0)
        meteor.Rotation = 30
        meteor.ZIndex = 9
        meteor.BackgroundTransparency = 1
        meteor.Parent = meteorHolder

        local grad = Instance.new("UIGradient")
        grad.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.5, 0.2),
            NumberSequenceKeypoint.new(1, 1)
        })
        grad.Parent = meteor

        local head = Instance.new("Frame")
        head.Size = UDim2.new(0, 8, 0, 8)
        head.Position = UDim2.new(1, -4, 0.5, -4)
        head.BackgroundColor3 = Color3.fromRGB(255, 120, 120)
        head.BackgroundTransparency = 1
        head.BorderSizePixel = 0
        head.ZIndex = 10
        head.Parent = meteor
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = head

        local duration = 2.5
        local endPos = UDim2.new(startX + 1.1, 0, startY + 0.8, 0)

        tweenService:Create(meteor, TweenInfo.new(0.4), { BackgroundTransparency = 0.1 }):Play()
        tweenService:Create(head, TweenInfo.new(0.4), { BackgroundTransparency = 0 }):Play()

        local moveTween = tweenService:Create(
            meteor,
            TweenInfo.new(duration, Enum.EasingStyle.Linear),
            { Position = endPos }
        )
        moveTween:Play()

        task.delay(duration * 0.55, function()
            if meteor.Parent then
                tweenService:Create(meteor, TweenInfo.new(duration * 0.45), { BackgroundTransparency = 1 }):Play()
                tweenService:Create(head, TweenInfo.new(duration * 0.45), { BackgroundTransparency = 1 }):Play()
            end
        end)

        moveTween.Completed:Connect(function()
            meteor:Destroy()
        end)
    end

    -- 阶段1：黑屏淡入
    tweenService:Create(bg, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { BackgroundTransparency = 0 }):Play()
    task.wait(0.4)

    -- 阶段2：所有星星 + 光晕渐入
    tweenService:Create(bigGlow, TweenInfo.new(1.2), {
        ImageTransparency = 0.5,
        Size = UDim2.new(0, 1000, 0, 1000),
        Position = UDim2.new(0.5, -500, 0.5, -500)
    }):Play()

    tweenService:Create(bigStarDeep, TweenInfo.new(0.8), { TextTransparency = 0.35 }):Play()
    tweenService:Create(bigStarMid, TweenInfo.new(0.8), { TextTransparency = 0.2 }):Play()
    tweenService:Create(bigStar, TweenInfo.new(0.8), { TextTransparency = 0 }):Play()
    tweenService:Create(bigStarShine, TweenInfo.new(0.8), { TextTransparency = 0.35 }):Play()
    tweenService:Create(bigStarCore, TweenInfo.new(0.8), { TextTransparency = 0.6 }):Play()

    tweenService:Create(starShadow, TweenInfo.new(0.6), { TextTransparency = 0.3 }):Play()
    tweenService:Create(star, TweenInfo.new(0.6), { TextTransparency = 0 }):Play()
    tweenService:Create(starShine, TweenInfo.new(0.6), { TextTransparency = 0.4 }):Play()

    -- 星星旋转
    local spinConn = runService.RenderStepped:Connect(function(dt)
        if bigStarHolder and bigStarHolder.Parent then
            bigStarHolder.Rotation = bigStarHolder.Rotation + dt * 45
        end
        if starHolder and starHolder.Parent then
            starHolder.Rotation = starHolder.Rotation + dt * 90
        end
    end)

    -- 小星星脉动
    task.spawn(function()
        while gui.Parent do
            local p1 = tweenService:Create(starHolder,
                TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                { Size = UDim2.new(0, 220, 0, 220), Position = UDim2.new(0.5, -110, 0.5, -110) })
            p1:Play(); p1.Completed:Wait()
            if not gui.Parent then break end
            local p2 = tweenService:Create(starHolder,
                TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                { Size = UDim2.new(0, 200, 0, 200), Position = UDim2.new(0.5, -100, 0.5, -100) })
            p2:Play(); p2.Completed:Wait()
        end
    end)

    -- 阶段3：持续约 4~5 秒，期间持续生成流星
    local totalTime = 4.5
    local elapsed = 0
    local timer = 0
    local interval = 0.5
    while elapsed < totalTime do
        local dt = runService.RenderStepped:Wait()
        elapsed = elapsed + dt
        timer = timer + dt
        if timer >= interval then
            timer = 0
            task.spawn(createMeteor)
        end
    end

    -- 阶段4：缓慢消失
    spinConn:Disconnect()
    tweenService:Create(bigStarDeep, TweenInfo.new(1), { TextTransparency = 1 }):Play()
    tweenService:Create(bigStarMid, TweenInfo.new(1), { TextTransparency = 1 }):Play()
    tweenService:Create(bigStar, TweenInfo.new(1), { TextTransparency = 1 }):Play()
    tweenService:Create(bigStarShine, TweenInfo.new(1), { TextTransparency = 1 }):Play()
    tweenService:Create(bigStarCore, TweenInfo.new(1), { TextTransparency = 1 }):Play()
    tweenService:Create(bigGlow, TweenInfo.new(1), {
        ImageTransparency = 1,
        Size = UDim2.new(0, 1400, 0, 1400),
        Position = UDim2.new(0.5, -700, 0.5, -700)
    }):Play()
    tweenService:Create(starShadow, TweenInfo.new(1), { TextTransparency = 1 }):Play()
    tweenService:Create(star, TweenInfo.new(1), { TextTransparency = 1 }):Play()
    tweenService:Create(starShine, TweenInfo.new(1), { TextTransparency = 1 }):Play()
    tweenService:Create(bg, TweenInfo.new(1), { BackgroundTransparency = 1 }):Play()

    task.wait(1.2)
    shakeConn:Disconnect()
    gui:Destroy()
end

-- 动画与脚本并行
task.spawn(function()
    pcall(playIntroAnimation)
end)

