local Players = game:GetService("Players")
local RS = game:GetService("RunService")
local lp = Players.LocalPlayer
local cam = workspace.CurrentCamera

local cfg = {
    main = false,
    highlight = false,
    name = false,
    survivorESP = false,
    fartESP = false,
}

local function isFarter(p)
    return p:GetAttribute("FartAbilityEnabled") == true
end

local function getColor(p)
    if isFarter(p) then
        return Color3.fromRGB(255, 80, 80)
    end
    return Color3.fromRGB(80, 255, 80)
end

local drawings = {}
local highlights = {}

local function clearPlayer(p)
    if drawings[p] then
        for _, d in pairs(drawings[p]) do
            d:Remove()
        end
        drawings[p] = nil
    end
    if highlights[p] then
        highlights[p]:Destroy()
        highlights[p] = nil
    end
end

local function makeHL(p, char)
    if highlights[p] then highlights[p]:Destroy() end
    local h = Instance.new("Highlight")
    h.FillColor = getColor(p)
    h.OutlineColor = Color3.fromRGB(255, 255, 255)
    h.FillTransparency = 0.5
    h.OutlineTransparency = 0
    h.Adornee = char
    h.Parent = char
    highlights[p] = h
end

local function makeName(p)
    if drawings[p] and drawings[p].nameTag then return end
    if not drawings[p] then drawings[p] = {} end
    local name = Drawing.new("Text")
    name.Text = p.Name
    name.Size = 20
    name.Font = Drawing.Fonts.UI
    name.Center = true
    name.Outline = true
    name.OutlineColor = Color3.fromRGB(0, 0, 0)
    name.Color = getColor(p)
    name.Visible = false
    drawings[p].nameTag = name
end

local function shouldShow(p)
    if not cfg.main then return false end
    if isFarter(p) and cfg.fartESP then return true end
    if not isFarter(p) and cfg.survivorESP then return true end
    return false
end

local function updatePlayer(p)
    if p == lp then return end
    local char = p.Character
    if not char then
        clearPlayer(p)
        return
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not shouldShow(p) then
        clearPlayer(p)
        return
    end
    if cfg.highlight then
        makeHL(p, char)
    elseif highlights[p] then
        highlights[p]:Destroy()
        highlights[p] = nil
    end
    if cfg.name then
        makeName(p)
        if root then
            local pos, vis = cam:WorldToViewportPoint(root.Position + Vector3.new(0, 3.2, 0))
            local show = vis and pos.Z > 0
            local col = getColor(p)
            if drawings[p] and drawings[p].nameTag then
                drawings[p].nameTag.Position = Vector2.new(pos.X, pos.Y)
                drawings[p].nameTag.Visible = show
                drawings[p].nameTag.Color = col
            end
        end
    elseif drawings[p] then
        if drawings[p].nameTag then
            drawings[p].nameTag:Remove()
            drawings[p].nameTag = nil
        end
    end
end

local function fullRefresh()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= lp then
            clearPlayer(p)
            updatePlayer(p)
        end
    end
end

RS.RenderStepped:Connect(function()
    if not cfg.main then return end
    for _, p in pairs(Players:GetPlayers()) do
        updatePlayer(p)
    end
end)

Players.PlayerRemoving:Connect(function(p)
    clearPlayer(p)
end)

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function()
        task.wait(0.5)
        updatePlayer(p)
    end)
end)

for _, p in pairs(Players:GetPlayers()) do
    if p ~= lp and p.Character then
        p.CharacterAdded:Connect(function()
            task.wait(0.5)
            updatePlayer(p)
        end)
    end
end

